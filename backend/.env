# Database
# For Docker Compose: override is set in docker-compose.yml (points to db service)
# For local dev (non-Docker): connects via the exposed port 5433
DATABASE_URL=postgresql+asyncpg://airbnb_user:airbnb_password@localhost:5433/airbnb_db

# JWT Authentication
SECRET_KEY=dev-secret-key-airbnb-clone-change-me-in-production-32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe Payments
STRIPE_API_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# Application
DEBUG=True
ENVIRONMENT=development
APP_NAME=Airbnb Clone API
APP_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
